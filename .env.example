# Environment variables for PROOFLYN
# Copy to .env and fill in values

# Database (SQLite — path relative to project root)
DATABASE_PATH=./data/prooflyn.db

# Upload storage
UPLOAD_DIR=./uploads

# MCP Server
MCP_TRANSPORT=stdio
MCP_SERVER_PORT=3001
MCP_AUTH_TOKEN=change-me-in-production

# Seeded users (for demo/dev only)
DEMO_INVESTIGATOR_EMAIL=investigator@prooflyn.dev
DEMO_INVESTIGATOR_PASSWORD=change-me
DEMO_REVIEWER_EMAIL=reviewer@prooflyn.dev
DEMO_REVIEWER_PASSWORD=change-me

# Session secret
SESSION_SECRET=change-this-to-a-random-string

# Optional: Gemini API key for AI-assisted extraction (not required for core functionality)
# GEMINI_API_KEY=

# App
NODE_ENV=development
PORT=3000
